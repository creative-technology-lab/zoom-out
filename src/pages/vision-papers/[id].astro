---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { matchTerritory, territories } from '../../lib/territories';

export async function getStaticPaths() {
  const papers = await getCollection('visionPapers');
  return papers.map(paper => ({
    params: { id: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const tags = (paper.data.tags ?? []).filter(t => !t.includes('/'));
const territory = matchTerritory(paper.data.tags ?? []);
const firstLetter = paper.data.title.charAt(0).toUpperCase();
---

<Base title={`${paper.data.title} — Zoom Out`}>
  <article class="pt-12 pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <a
        href="/"
        class="inline-flex items-center gap-1 text-sm text-(--color-muted) hover:text-(--color-fg) transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back
      </a>

      <header class="relative mt-10 overflow-hidden">
        <div class="absolute -top-6 -right-4 md:-right-8 depth-letter text-[14rem] md:text-[20rem] select-none" aria-hidden="true">
          {firstLetter}
        </div>
        <div class="relative">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-[0.625rem] font-medium uppercase tracking-widest px-2 py-0.5 rounded bg-(--color-brand)/10 text-(--color-brand-muted)">
              White Paper
            </span>
            {territory && (
              <span class="text-[0.625rem] font-medium uppercase tracking-widest text-(--color-muted)">
                {territory.name}
              </span>
            )}
          </div>
          <time class="text-sm text-(--color-muted) tracking-wide">{formatDate(paper.data.created)}</time>
          <h1 class="font-heading text-3xl md:text-4xl lg:text-[2.75rem] font-bold mt-4 leading-tight tracking-tight max-w-2xl">
            {paper.data.title}
          </h1>
          {tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {tags.map(tag => (
                <span class="px-2.5 py-0.5 text-xs rounded-full text-(--color-muted) border border-(--color-border)">
                  {tag.replace(/-/g, ' ')}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="mt-12 mb-10 h-px bg-gradient-to-r from-(--color-border) via-(--color-border) to-transparent"></div>

      <div class="prose">
        <Content />
      </div>

      <div class="mt-16 pt-10 border-t border-(--color-border)">
        <a
          href="/"
          class="inline-flex items-center gap-1 text-sm text-(--color-muted) hover:text-(--color-fg) transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          All articles
        </a>
      </div>
    </div>
  </article>
</Base>
