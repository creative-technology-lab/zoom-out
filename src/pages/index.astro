---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data, id }) => {
  return id !== '2026-05-16-example-idea' && data.title !== '';
});

const sorted = allArticles.sort((a, b) => b.data.created.getTime() - a.data.created.getTime());

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

const articles = sorted.map(a => ({
  id: a.id,
  title: a.data.title,
  date: formatDate(a.data.created),
  tags: (a.data.tags ?? []).map(t => t.replace(/-/g, ' ')),
}));
---

<Base title="Zoom Out">
  <section class="pt-16 pb-8">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="font-heading text-3xl md:text-4xl font-bold tracking-tight">
        Zoom Out
      </h1>
      <p class="mt-3 text-(--color-muted) text-lg leading-relaxed max-w-xl">
        Perspectives on creative technology, AI architecture, and the future of digital experiences.
      </p>
    </div>
  </section>

  <section class="pb-24">
    <div class="max-w-3xl mx-auto px-6">
      <div class="divide-y divide-(--color-border)">
        {articles.map(article => (
          <a href={`/articles/${article.id}`} class="group block py-8 first:pt-4">
            <time class="text-xs text-(--color-muted) font-medium uppercase tracking-wider">
              {article.date}
            </time>
            <h2 class="font-heading text-xl md:text-2xl font-bold mt-2 group-hover:text-(--color-link) transition-colors">
              {article.title}
            </h2>
            {article.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {article.tags.slice(0, 4).map(tag => (
                  <span class="px-2 py-0.5 text-xs rounded-full text-(--color-muted) border border-(--color-border)">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
