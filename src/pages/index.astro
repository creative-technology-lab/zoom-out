---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { territories, matchTerritory } from '../lib/territories';

const allArticles = await getCollection('articles', ({ data, id }) => {
  return id !== '2026-05-16-example-idea' && data.title !== '';
});
const allVisionPapers = await getCollection('visionPapers');

const territoryColors: Record<string, string> = {
  'the-people': '#B8D44E',
  'the-governance': '#6BBFC4',
  'the-experience': '#9580C4',
  'the-tools': '#4ED8A0',
  'the-consumer': '#D4907E',
  'zoom-out': '#C4B078',
};

type ContentItem = {
  id: string;
  rawId: string;
  title: string;
  kind: 'vision-paper' | 'article';
  collection: 'visionPapers' | 'articles';
  tags: string[];
  territory: string | null;
  url: string;
  created: Date;
};

const allContent: ContentItem[] = [
  ...allVisionPapers.map(vp => ({
    id: `vp:${vp.id}`,
    rawId: vp.id,
    title: vp.data.title,
    kind: 'vision-paper' as const,
    collection: 'visionPapers' as const,
    tags: vp.data.tags ?? [],
    territory: matchTerritory(vp.data.tags ?? [])?.id ?? null,
    url: `/vision-papers/${vp.id}`,
    created: vp.data.created,
  })),
  ...allArticles.map(a => ({
    id: `art:${a.id}`,
    rawId: a.id,
    title: a.data.title,
    kind: 'article' as const,
    collection: 'articles' as const,
    tags: a.data.tags ?? [],
    territory: matchTerritory(a.data.tags ?? [])?.id ?? null,
    url: `/articles/${a.id}`,
    created: a.data.created,
  })),
];

const territorySections = territories.map(t => {
  const items = allContent
    .filter(c => c.territory === t.id)
    .sort((a, b) => {
      if (a.kind !== b.kind) return a.kind === 'vision-paper' ? -1 : 1;
      return b.created.getTime() - a.created.getTime();
    });
  return { ...t, items };
});

const unmatched = allContent
  .filter(c => !c.territory)
  .sort((a, b) => b.created.getTime() - a.created.getTime());

// Nav view data: hub-and-spoke with expandable territories
const navData = {
  center: { id: '__center__', label: 'The Future of Experience' },
  territories: territories
    .map(t => {
      const items = allContent.filter(c => c.territory === t.id);
      return {
        id: t.id,
        name: t.name,
        subtitle: t.subtitle,
        color: territoryColors[t.id] ?? '#71717a',
        items: items.map(c => ({ id: c.id, title: c.title, kind: c.kind, url: c.url })),
      };
    })
    .filter(t => t.items.length > 0),
};

// Universe view data: all nodes + shared-tag connections (Obsidian style)
const universeNodes = allContent.map(n => ({
  id: n.id,
  label: n.title,
  kind: n.kind,
  territory: n.territory,
  url: n.url,
  color: territoryColors[n.territory ?? ''] ?? '#71717a',
}));

const universeLinks: { source: string; target: string; strength: number }[] = [];

// Explicit related_articles
for (const vp of allVisionPapers) {
  for (const ref of (vp.data.related_articles ?? [])) {
    const slug = ref.replace(/^.*\//, '').replace(/\.md$/, '');
    const target = universeNodes.find(n => n.id.endsWith(slug));
    if (target) {
      universeLinks.push({ source: `vp:${vp.id}`, target: target.id, strength: 1 });
    }
  }
}

// Shared-tag connections
for (let i = 0; i < allContent.length; i++) {
  for (let j = i + 1; j < allContent.length; j++) {
    const a = allContent[i], b = allContent[j];
    const shared = a.tags.filter(t => b.tags.includes(t));
    const threshold = (a.kind === 'article' && b.kind === 'article') ? 2 : 1;
    if (shared.length >= threshold) {
      const exists = universeLinks.some(l =>
        (l.source === a.id && l.target === b.id) || (l.source === b.id && l.target === a.id)
      );
      if (!exists) universeLinks.push({ source: a.id, target: b.id, strength: shared.length });
    }
  }
}

const connectedIds = new Set(universeLinks.flatMap(l => [l.source, l.target]));

const universeData = {
  nodes: universeNodes.filter(n => connectedIds.has(n.id)),
  links: universeLinks,
  territories: territories
    .filter(t => universeNodes.some(n => n.territory === t.id))
    .map(t => ({ id: t.id, name: t.name, color: territoryColors[t.id] ?? '#71717a' })),
};
---

<Base title="Zoom Out">
  <section class="relative pt-20 md:pt-28 pb-6 overflow-hidden">
    <div class="max-w-3xl mx-auto px-6 relative">
      <div class="absolute -top-8 -left-4 md:-left-12 depth-letter text-[12rem] md:text-[18rem] select-none" aria-hidden="true">
        ZO
      </div>
      <div class="relative flex items-end justify-between gap-4">
        <div>
          <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
            Zoom Out
          </h1>
          <p class="mt-5 text-(--color-muted) text-lg md:text-xl leading-relaxed max-w-lg tracking-wide font-light">
            The future of experience.
          </p>
        </div>
        <div id="view-toggle" class="flex gap-1 p-1 rounded-lg border border-(--color-border) bg-(--color-surface)/60 backdrop-blur-sm shrink-0">
          <button data-view="nav" class="view-btn px-3 py-1.5 rounded-md transition-all cursor-pointer" aria-label="Navigate territories">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="4" r="1.5"/><circle cx="19.8" cy="8" r="1.5"/><circle cx="19.8" cy="16" r="1.5"/><circle cx="12" cy="20" r="1.5"/><circle cx="4.2" cy="16" r="1.5"/><circle cx="4.2" cy="8" r="1.5"/></svg>
          </button>
          <button data-view="universe" class="view-btn px-3 py-1.5 rounded-md transition-all cursor-pointer" aria-label="Explore connections">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="12" cy="4" r="1.5"/><circle cx="19" cy="7" r="2.5"/><circle cx="7" cy="14" r="1.5"/><circle cx="16" cy="13" r="2"/><circle cx="11" cy="19" r="1.5"/><line x1="7" y1="6" x2="10.5" y2="4.5"/><line x1="13.5" y1="4.5" x2="17" y2="6"/><line x1="6" y1="8" x2="6.5" y2="12.5"/><line x1="8.5" y1="14" x2="14" y2="13"/><line x1="15" y1="15" x2="12" y2="17.5"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <div id="graph-view" class="relative" style="height: 500px;">
    <div id="graph-container" class="w-full" style="height: 500px; position: relative;"></div>
    <div id="graph-legend" class="absolute top-3 left-3 z-10 hidden flex-wrap gap-3 text-xs bg-(--color-bg)/70 backdrop-blur-md rounded-lg px-3 py-2">
      {universeData.territories.map(t => (
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full" style={`background: ${t.color}`}></span>
          {t.name}
        </span>
      ))}
    </div>
    <div
      id="graph-tooltip"
      class="fixed pointer-events-none z-50 px-3 py-2 rounded-lg text-sm font-medium shadow-lg border max-w-xs"
      style="display: none; background: var(--color-surface); border-color: var(--color-border); color: var(--color-fg);"
    ></div>
  </div>

  <script is:inline define:vars={{ navData, universeData }}>
    window.__NAV_DATA__ = navData;
    window.__UNIVERSE_DATA__ = universeData;
  </script>
  <script>
    import ForceGraph from 'force-graph';

    let graph: any = null;
    let currentView: string = 'nav';

    const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';
    const centerColor = () => isDark() ? '#fafafa' : '#18181b';
    const centerTextColor = () => isDark() ? '#09090b' : '#fafafa';
    const textColor = () => isDark() ? '#fafafa' : '#18181b';
    const mutedColor = () => isDark() ? '#a1a1aa' : '#71717a';
    const lineBase = () => isDark() ? 'rgba(161,161,170,' : 'rgba(113,113,122,';

    let hoveredNode: any = null;
    let neighbors = new Set<string>();
    let expandedTerritory: string | null = null;

    function getNeighborIds(nodeId: string) {
      const s = new Set<string>();
      if (!graph) return s;
      graph.graphData().links.forEach((l: any) => {
        const sid = typeof l.source === 'object' ? l.source.id : l.source;
        const tid = typeof l.target === 'object' ? l.target.id : l.target;
        if (sid === nodeId) s.add(tid);
        if (tid === nodeId) s.add(sid);
      });
      return s;
    }

    // -- NAV VIEW (hub-and-spoke) --

    function buildNavGraph() {
      const data = (window as any).__NAV_DATA__;
      const nodes: any[] = [
        { id: '__center__', label: data.center.label, kind: 'center', color: centerColor(), r: 32 },
      ];
      const links: any[] = [];

      data.territories.forEach((t: any) => {
        const isExpanded = expandedTerritory === t.id;
        nodes.push({
          id: t.id, label: t.name, subtitle: t.subtitle,
          kind: 'territory', color: t.color,
          r: isExpanded ? 22 : 18, expanded: isExpanded,
        });
        links.push({ source: '__center__', target: t.id, kind: 'hub' });

        if (isExpanded) {
          t.items.forEach((item: any) => {
            nodes.push({
              id: item.id, label: item.title, kind: item.kind,
              color: t.color, url: item.url,
              r: item.kind === 'vision-paper' ? 9 : 5,
            });
            links.push({ source: t.id, target: item.id, kind: 'child' });
          });
        }
      });

      return { nodes, links };
    }

    function applyNavForces() {
      graph.d3Force('charge')!.strength((d: any) => {
        if (d.kind === 'center') return -500;
        if (d.kind === 'territory') return -300;
        return -80;
      });
      graph.d3Force('link')!
        .distance((l: any) => l.kind === 'hub' ? 120 : 50)
        .strength((l: any) => l.kind === 'hub' ? 0.5 : 0.8);
      graph.d3Force('center')!.strength(0.08);
    }

    function renderNavNode(node: any, ctx: CanvasRenderingContext2D, globalScale: number) {
      const r = node.r || 8;
      const isCenter = node.kind === 'center';
      const isTerritory = node.kind === 'territory';
      const isHovered = node === hoveredNode;
      const isNeighbor = hoveredNode && neighbors.has(node.id);
      const dimmed = hoveredNode && !isHovered && !isNeighbor;

      ctx.beginPath();
      ctx.arc(node.x, node.y, r, 0, 2 * Math.PI);

      if (dimmed) ctx.globalAlpha = 0.1;
      else if (isHovered) {
        ctx.globalAlpha = 1;
        if (!isCenter) { ctx.shadowColor = node.color; ctx.shadowBlur = 20; }
      } else ctx.globalAlpha = 0.9;

      ctx.fillStyle = isCenter ? centerColor() : node.color;
      ctx.fill();
      ctx.shadowBlur = 0;

      if (node.kind === 'vision-paper') {
        ctx.strokeStyle = isDark() ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.15)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      ctx.globalAlpha = 1;

      if (isCenter) {
        ctx.globalAlpha = dimmed ? 0.1 : 1;
        ctx.font = `700 9px 'Space Grotesk', system-ui, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = centerTextColor();
        ctx.fillText('THE FUTURE', node.x, node.y - 5);
        ctx.fillText('OF EXPERIENCE', node.x, node.y + 5);
        ctx.globalAlpha = 1;
        return;
      }

      if (isTerritory) {
        ctx.globalAlpha = dimmed ? 0.08 : 1;
        ctx.font = `600 12px 'Space Grotesk', system-ui, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillStyle = textColor();
        ctx.fillText(node.label, node.x, node.y + r + 6);
        if (isHovered && node.subtitle) {
          ctx.font = `400 9px 'Inter', system-ui, sans-serif`;
          ctx.fillStyle = mutedColor();
          ctx.fillText(node.subtitle, node.x, node.y + r + 22);
        }
        ctx.globalAlpha = 1;
        return;
      }

      // Content nodes: show label on hover or zoomed in
      if (isHovered || (globalScale > 1.8 && !dimmed)) {
        const fs = Math.max(9 / globalScale, 2.5);
        ctx.globalAlpha = dimmed ? 0.08 : 1;
        ctx.font = `500 ${fs}px 'Inter', system-ui, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillStyle = textColor();
        ctx.fillText(node.label, node.x, node.y + r + 3);
        ctx.globalAlpha = 1;
      }
    }

    // -- UNIVERSE VIEW (Obsidian-style) --

    function buildUniverseGraph() {
      const data = (window as any).__UNIVERSE_DATA__;
      return {
        nodes: data.nodes.map((n: any) => ({ ...n })),
        links: data.links.map((l: any) => ({ ...l })),
      };
    }

    function applyUniverseForces() {
      graph.d3Force('charge')!.strength(-180);
      graph.d3Force('link')!
        .distance((l: any) => (l.strength || 1) > 2 ? 50 : 90)
        .strength(0.5);
      graph.d3Force('center')!.strength(0.1);
    }

    function renderUniverseNode(node: any, ctx: CanvasRenderingContext2D, globalScale: number) {
      const r = node.kind === 'vision-paper' ? 10 : 5;
      const isHovered = node === hoveredNode;
      const isNeighbor = hoveredNode && neighbors.has(node.id);
      const dimmed = hoveredNode && !isHovered && !isNeighbor;

      ctx.beginPath();
      ctx.arc(node.x, node.y, r, 0, 2 * Math.PI);

      if (dimmed) ctx.globalAlpha = 0.12;
      else if (isHovered) {
        ctx.globalAlpha = 1;
        ctx.shadowColor = node.color;
        ctx.shadowBlur = 16;
      } else if (isNeighbor) ctx.globalAlpha = 1;
      else ctx.globalAlpha = 0.85;

      ctx.fillStyle = node.color;
      ctx.fill();
      ctx.shadowBlur = 0;

      if (node.kind === 'vision-paper') {
        ctx.strokeStyle = isDark() ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.15)';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      ctx.globalAlpha = 1;

      if (isHovered || (globalScale > 2.5 && !dimmed)) {
        const fs = Math.max(10 / globalScale, 2);
        ctx.font = `600 ${fs}px 'Space Grotesk', system-ui, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillStyle = textColor();
        ctx.globalAlpha = dimmed ? 0.1 : 1;
        ctx.fillText(node.label, node.x, node.y + r + 3);
        ctx.globalAlpha = 1;
      }
    }

    // -- SHARED LINK RENDERER --

    function renderLink(link: any, ctx: CanvasRenderingContext2D) {
      const src = link.source;
      const tgt = link.target;
      if (!src || !tgt || typeof src.x === 'undefined') return;

      const isHighlighted = hoveredNode && (src.id === hoveredNode.id || tgt.id === hoveredNode.id);
      const dimmed = hoveredNode && !isHighlighted;

      ctx.beginPath();
      ctx.moveTo(src.x, src.y);
      ctx.lineTo(tgt.x, tgt.y);

      if (dimmed) ctx.strokeStyle = lineBase() + '0.03)';
      else if (isHighlighted) ctx.strokeStyle = lineBase() + '0.5)';
      else ctx.strokeStyle = lineBase() + '0.12)';

      const strength = link.strength || 1;
      ctx.lineWidth = isHighlighted ? Math.sqrt(strength) * 2 : Math.sqrt(strength) * (link.kind === 'hub' ? 1 : 0.8);
      ctx.stroke();
    }

    // -- VIEW SWITCHING --

    function setView(view: string) {
      currentView = view;
      localStorage.setItem('zo-view', view);

      const container = document.getElementById('graph-container')!;
      const tooltip = document.getElementById('graph-tooltip')!;
      const legend = document.getElementById('graph-legend')!;
      const btns = document.querySelectorAll('.view-btn');

      btns.forEach(btn => {
        const isActive = (btn as HTMLElement).dataset.view === view;
        (btn as HTMLElement).style.background = isActive
          ? (isDark() ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.08)') : 'transparent';
        (btn as HTMLElement).style.color = isActive
          ? (isDark() ? '#fafafa' : '#18181b')
          : (isDark() ? '#71717a' : '#a1a1aa');
      });

      // Reset state
      hoveredNode = null;
      neighbors = new Set();
      expandedTerritory = null;
      tooltip.style.display = 'none';

      if (graph) {
        graph._destructor();
        graph = null;
        container.innerHTML = '';
      }

      const isNav = view === 'nav';
      legend.classList.toggle('hidden', isNav);
      legend.classList.toggle('flex', !isNav);

      graph = ForceGraph()(container)
        .nodeId('id')
        .nodeLabel('')
        .nodeCanvasObjectMode(() => 'replace')
        .nodeCanvasObject((n: any, ctx: any, gs: number) =>
          isNav ? renderNavNode(n, ctx, gs) : renderUniverseNode(n, ctx, gs)
        )
        .nodePointerAreaPaint((node: any, color: string, ctx: CanvasRenderingContext2D) => {
          const r = node.r || (node.kind === 'vision-paper' ? 10 : 5);
          const hitR = Math.max(r, 14);
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(node.x, node.y, hitR, 0, 2 * Math.PI);
          ctx.fill();
        })
        .linkCanvasObjectMode(() => 'replace')
        .linkCanvasObject(renderLink)
        .enableZoomInteraction(false)
        .enablePanInteraction(false);

      const gd = isNav ? buildNavGraph() : buildUniverseGraph();
      graph.graphData(gd);

      if (isNav) {
        applyNavForces();
        const cn = gd.nodes.find((n: any) => n.id === '__center__') as any;
        if (cn) { cn.fx = 0; cn.fy = 0; }
      } else {
        applyUniverseForces();
      }

      graph.onEngineStop(() => graph.zoomToFit(400, 80));

      graph.onNodeHover((node: any) => {
        hoveredNode = node || null;
        neighbors = node ? getNeighborIds(node.id) : new Set();
        container.style.cursor = node && node.kind !== 'center' ? 'pointer' : 'default';

        if (node && node.kind !== 'center') {
          let typeLabel = '';
          if (isNav && node.kind === 'territory') {
            typeLabel = node.expanded ? 'Click to collapse' : 'Click to expand';
          } else {
            typeLabel = node.kind === 'vision-paper' ? 'White Paper' : 'Article';
          }
          tooltip.innerHTML = `
            <div style="font-family:'Space Grotesk',system-ui,sans-serif;font-weight:600;margin-bottom:2px">${node.label}</div>
            <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;opacity:0.6">${typeLabel}</div>
          `;
          tooltip.style.display = 'block';
        } else {
          tooltip.style.display = 'none';
        }
      });

      container.addEventListener('mousemove', (e: MouseEvent) => {
        if (tooltip.style.display === 'block') {
          tooltip.style.left = (e.clientX + 14) + 'px';
          tooltip.style.top = (e.clientY + 14) + 'px';
        }
      });

      graph.onNodeClick((node: any) => {
        if (!node) return;

        if (isNav && node.kind === 'territory') {
          expandedTerritory = expandedTerritory === node.id ? null : node.id;
          hoveredNode = null;
          neighbors = new Set();
          tooltip.style.display = 'none';
          const newGd = buildNavGraph();
          const c = newGd.nodes.find((n: any) => n.id === '__center__') as any;
          if (c) { c.fx = 0; c.fy = 0; }
          graph.graphData(newGd);
          applyNavForces();
          setTimeout(() => graph.zoomToFit(600, 80), 800);
          return;
        }

        if (node.url) window.location.href = node.url;
      });

      graph.onNodeDragEnd((node: any) => {
        if (node.id !== '__center__') { node.fx = undefined; node.fy = undefined; }
      });

      const ro = new ResizeObserver(() => {
        graph.width(container.offsetWidth);
        graph.height(container.offsetHeight);
      });
      ro.observe(container);
    }

    // Toggle buttons
    document.querySelectorAll('.view-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        setView((btn as HTMLElement).dataset.view || 'nav');
      });
    });

    // Theme toggle: refresh graph
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      setTimeout(() => {
        if (graph) {
          if (currentView === 'nav') {
            const cn = graph.graphData().nodes.find((n: any) => n.id === '__center__');
            if (cn) cn.color = centerColor();
          }
          graph.refresh();
        }
        // Re-style toggle buttons
        const btns = document.querySelectorAll('.view-btn');
        btns.forEach(btn => {
          const isActive = (btn as HTMLElement).dataset.view === currentView;
          (btn as HTMLElement).style.background = isActive
            ? (isDark() ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.08)') : 'transparent';
          (btn as HTMLElement).style.color = isActive
            ? (isDark() ? '#fafafa' : '#18181b')
            : (isDark() ? '#71717a' : '#a1a1aa');
        });
      }, 50);
    });

    // Init with saved view
    setView(localStorage.getItem('zo-view') || 'nav');
  </script>

  <section class="pb-24 pt-8 border-t border-(--color-border)">
    <div class="max-w-3xl mx-auto px-6">
      {territorySections.map((territory, ti) => (
        territory.items.length > 0 && (
          <div id={territory.id} class="pt-16 scroll-mt-28">
            <div class="relative mb-6">
              <div
                class="absolute -top-2 -right-2 md:-right-6 depth-number text-[4rem] md:text-[5.5rem]"
                aria-hidden="true"
                style={`color: ${territoryColors[territory.id] ?? 'var(--color-depth)'}; opacity: 0.08;`}
              >
                {String(ti + 1).padStart(2, '0')}
              </div>
              <div class="relative">
                <h2
                  class="font-heading text-2xl md:text-3xl font-bold tracking-tight"
                  style={`color: ${territoryColors[territory.id]};`}
                >
                  {territory.name}
                </h2>
                <p class="text-sm text-(--color-muted) mt-1 tracking-wide">
                  {territory.subtitle}
                </p>
              </div>
            </div>

            <div class="border-t" style={`border-color: ${territoryColors[territory.id] ?? 'var(--color-border)'}20;`}>
              {territory.items.map(item => (
                <a
                  href={item.url}
                  class:list={[
                    'group block border-b border-(--color-border)',
                    item.kind === 'vision-paper' ? 'py-6' : 'py-4',
                  ]}
                >
                  <span
                    class:list={[
                      'block text-[0.5625rem] uppercase tracking-widest mb-1 font-semibold',
                    ]}
                    style={`color: ${territoryColors[territory.id] ?? 'var(--color-muted)'}; opacity: 0.6;`}
                  >
                    {item.kind === 'vision-paper' ? 'white paper' : 'article'}
                  </span>
                  <h3 class:list={[
                    'font-heading group-hover:text-(--color-link) transition-colors leading-snug',
                    item.kind === 'vision-paper'
                      ? 'text-lg md:text-xl font-bold'
                      : 'text-sm md:text-base font-medium text-(--color-brand-muted)',
                  ]}>
                    {item.title}
                  </h3>
                </a>
              ))}
            </div>
          </div>
        )
      ))}

      {unmatched.length > 0 && (
        <div id="more" class="pt-16 scroll-mt-28">
          <div class="relative mb-6">
            <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight">More</h2>
          </div>
          <div class="border-t border-(--color-border)">
            {unmatched.map(item => (
              <a
                href={item.url}
                class="group block py-4 border-b border-(--color-border)"
              >
                <h3 class="font-heading text-sm md:text-base font-medium text-(--color-brand-muted) group-hover:text-(--color-link) transition-colors leading-snug">
                  {item.title}
                </h3>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
