---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { territories, matchTerritory } from '../lib/territories';

const allArticles = await getCollection('articles', ({ data, id }) => {
  return id !== '2026-05-16-example-idea' && data.title !== '';
});

const allVisionPapers = await getCollection('visionPapers');

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

type ContentItem = {
  id: string;
  title: string;
  date: string;
  created: Date;
  tags: string[];
  kind: 'vision-paper' | 'article';
  collection: 'visionPapers' | 'articles';
};

const allContent: ContentItem[] = [
  ...allArticles.map(a => ({
    id: a.id,
    title: a.data.title,
    date: formatDate(a.data.created),
    created: a.data.created,
    tags: a.data.tags ?? [],
    kind: 'article' as const,
    collection: 'articles' as const,
  })),
  ...allVisionPapers.map(a => ({
    id: a.id,
    title: a.data.title,
    date: formatDate(a.data.created),
    created: a.data.created,
    tags: a.data.tags ?? [],
    kind: 'vision-paper' as const,
    collection: 'visionPapers' as const,
  })),
];

const territorySections = territories.map(t => {
  const items = allContent
    .filter(c => matchTerritory(c.tags)?.id === t.id)
    .sort((a, b) => {
      if (a.kind !== b.kind) return a.kind === 'vision-paper' ? -1 : 1;
      return b.created.getTime() - a.created.getTime();
    });
  return { ...t, items };
});

const unmatched = allContent
  .filter(c => !matchTerritory(c.tags))
  .sort((a, b) => b.created.getTime() - a.created.getTime());
---

<Base title="Zoom Out">
  <section class="relative pt-20 md:pt-28 pb-12 overflow-hidden">
    <div class="max-w-3xl mx-auto px-6 relative">
      <div class="absolute -top-8 -left-4 md:-left-12 depth-letter text-[12rem] md:text-[18rem] select-none" aria-hidden="true">
        ZO
      </div>
      <div class="relative">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
          Zoom Out
        </h1>
        <p class="mt-5 text-(--color-muted) text-lg md:text-xl leading-relaxed max-w-lg tracking-wide font-light">
          The future of experience.
        </p>
      </div>
    </div>
  </section>

  <nav class="sticky top-14 z-40 border-b border-(--color-border) bg-(--color-bg)/80 backdrop-blur-lg">
    <div class="max-w-3xl mx-auto px-6 flex gap-1 overflow-x-auto py-2 scrollbar-none">
      {territorySections.map((t) => (
        t.items.length > 0 && (
          <a
            href={`#${t.id}`}
            class="shrink-0 px-3 py-1.5 text-xs font-medium rounded-full border border-(--color-border) text-(--color-muted) hover:text-(--color-fg) hover:border-(--color-brand-muted) transition-colors"
          >
            {t.name}
          </a>
        )
      ))}
      {unmatched.length > 0 && (
        <a
          href="#more"
          class="shrink-0 px-3 py-1.5 text-xs font-medium rounded-full border border-(--color-border) text-(--color-muted) hover:text-(--color-fg) hover:border-(--color-brand-muted) transition-colors"
        >
          More
        </a>
      )}
    </div>
  </nav>

  <section class="pb-24">
    <div class="max-w-3xl mx-auto px-6">
      {territorySections.map((territory, ti) => (
        territory.items.length > 0 && (
          <div id={territory.id} class="pt-16 scroll-mt-28">
            <div class="relative mb-6">
              <div class="absolute -top-2 -right-2 md:-right-6 depth-number text-[4rem] md:text-[5.5rem]" aria-hidden="true">
                {String(ti + 1).padStart(2, '0')}
              </div>
              <div class="relative">
                <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight">
                  {territory.name}
                </h2>
                <p class="text-sm text-(--color-muted) mt-1 tracking-wide">
                  {territory.subtitle}
                </p>
              </div>
            </div>

            <div class="border-t border-(--color-border)">
              {territory.items.map(item => (
                <a
                  href={item.collection === 'visionPapers' ? `/vision-papers/${item.id}` : `/articles/${item.id}`}
                  class:list={[
                    'group block border-b border-(--color-border)',
                    item.kind === 'vision-paper' ? 'py-6' : 'py-4',
                  ]}
                >
                  <span class:list={[
                    'block text-[0.5625rem] uppercase tracking-widest mb-1',
                    item.kind === 'vision-paper' ? 'text-(--color-brand-muted) font-semibold' : 'text-(--color-muted)',
                  ]}>
                    {item.kind === 'vision-paper' ? 'white paper' : 'article'}
                  </span>
                  <h3 class:list={[
                    'font-heading group-hover:text-(--color-link) transition-colors leading-snug',
                    item.kind === 'vision-paper'
                      ? 'text-lg md:text-xl font-bold'
                      : 'text-sm md:text-base font-medium text-(--color-brand-muted)',
                  ]}>
                    {item.title}
                  </h3>
                </a>
              ))}
            </div>
          </div>
        )
      ))}

      {unmatched.length > 0 && (
        <div id="more" class="pt-16 scroll-mt-28">
          <div class="relative mb-6">
            <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight">More</h2>
          </div>
          <div class="border-t border-(--color-border)">
            {unmatched.map(item => (
              <a
                href={item.collection === 'visionPapers' ? `/vision-papers/${item.id}` : `/articles/${item.id}`}
                class="group block py-4 border-b border-(--color-border)"
              >
                <h3 class="font-heading text-sm md:text-base font-medium text-(--color-brand-muted) group-hover:text-(--color-link) transition-colors leading-snug">
                  {item.title}
                </h3>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
